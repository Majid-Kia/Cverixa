// Cverixa data model. See docs/data-model.md for the rationale behind each entity.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The owner account. The MVP is single-user; ownership columns on every
/// entity keep the boundary ready for a later multi-user mode.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions                Session[]
  careerProfiles          CareerProfile[]
  jobDescriptions         JobDescription[]
  resumes                 Resume[]
  generationRuns          GenerationRun[]
  aiConfigurations        AIProviderConfiguration[]
  importSessions          ImportSession[]
  coverLetters            CoverLetter[]
  jobSearchPreferences    JobSearchPreferences?
  jobSourceConfigurations JobSourceConfiguration[]
  jobListings             JobListing[]
  jobMatchAnalyses        JobMatchAnalysis[]
  jobListingEvents        JobListingEvent[]
  jobScans                JobScan[]
}

/// Database-backed login session referenced by an HttpOnly cookie.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Master Career Profile. Content lives in immutable revisions.
model CareerProfile {
  id                String   @id @default(cuid())
  ownerId           String
  name              String
  currentRevisionId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner           User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  currentRevision CareerProfileRevision?  @relation("CurrentRevision", fields: [currentRevisionId], references: [id])
  revisions       CareerProfileRevision[] @relation("ProfileRevisions")
  resumes         Resume[]

  @@index([ownerId])
}

model CareerProfileRevision {
  id             String    @id @default(cuid())
  profileId      String
  version        Int
  schemaVersion  Int       @default(1)
  structuredData Json
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())

  profile        CareerProfile   @relation("ProfileRevisions", fields: [profileId], references: [id], onDelete: Cascade)
  currentOf      CareerProfile?  @relation("CurrentRevision")
  generationRuns GenerationRun[]

  @@unique([profileId, version])
}

/// A pending resume import awaiting user review and confirmation.
model ImportSession {
  id             String   @id @default(cuid())
  ownerId        String
  fileName       String
  fileType       String
  warnings       Json
  structuredData Json
  createdAt      DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model JobDescription {
  id                     String    @id @default(cuid())
  ownerId                String
  title                  String?
  company                String?
  location               String?
  sourceUrl              String?
  notes                  String?
  originalText           String
  structuredRequirements Json?
  analysisProviderId     String?
  analysisModelId        String?
  analyzedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  resumes        Resume[]
  generationRuns GenerationRun[]
  coverLetter    CoverLetter?
  /// Set when this job description was created from a Job Scanner listing.
  jobListing     JobListing?

  @@index([ownerId, createdAt])
}

/// The cover letter for one job description. There is one per job; generating
/// again replaces it. The body is plain text the owner can edit.
model CoverLetter {
  id                      String   @id @default(cuid())
  ownerId                 String
  jobDescriptionId        String   @unique
  careerProfileRevisionId String?
  body                    String
  /// What the fact check removed and which criteria the letter does not claim.
  report                  Json?
  providerId              String
  modelId                 String
  userInstructions        String?
  /// True once the owner has saved their own edits to the generated text.
  edited                  Boolean  @default(false)
  generatedAt             DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
}

model Resume {
  id                String   @id @default(cuid())
  ownerId           String
  careerProfileId   String
  jobDescriptionId  String?
  title             String
  /// Manual application tracking: pending | interview | rejected. Belongs to the resume, not to a version.
  applicationStatus String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  careerProfile  CareerProfile    @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  jobDescription JobDescription?  @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  revisions      ResumeRevision[]

  @@index([ownerId, updatedAt])
}

/// Immutable snapshot of a generated or edited resume.
model ResumeRevision {
  id                      String   @id @default(cuid())
  resumeId                String
  version                 Int
  schemaVersion           Int      @default(1)
  templateId              String
  pageFormat              String   @default("A4")
  careerProfileRevisionId String?
  content                 Json
  changeReport            Json?
  generationMetadata      Json?
  validationStatus        String
  createdAt               DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, version])
}

model GenerationRun {
  id                      String    @id @default(cuid())
  ownerId                 String
  careerProfileRevisionId String
  jobDescriptionId        String
  providerId              String
  modelId                 String
  mode                    String
  templateId              String
  userInstructions        String?
  status                  String
  failureReason           String?
  /// Review Mode: proposals and baseline/tailored content awaiting decisions.
  proposal                Json?
  resultResumeId          String?
  resultRevisionId        String?
  startedAt               DateTime  @default(now())
  finishedAt              DateTime?

  owner                 User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  careerProfileRevision CareerProfileRevision @relation(fields: [careerProfileRevisionId], references: [id], onDelete: Cascade)
  jobDescription        JobDescription        @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@index([ownerId, startedAt])
}

/// Non-secret provider preferences. API keys are read from environment variables only.
model AIProviderConfiguration {
  id            String   @id @default(cuid())
  ownerId       String
  providerId    String
  modelId       String
  isDefault     Boolean  @default(false)
  configuration Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, providerId])
}

/// Job Scanner: what the owner is looking for, the filters to apply and when to
/// scan automatically. One row per owner, created when preferences are saved.
model JobSearchPreferences {
  id                      String    @id @default(cuid())
  ownerId                 String    @unique
  /// ISO 3166-1 alpha-2 country codes. An empty list means any country.
  countries               Json
  /// Job titles and keywords matched against listing titles.
  keywords                Json
  /// onsite | hybrid | remote. An empty list means any arrangement.
  workArrangements        Json
  /// Keep only listings with confirmed or possible sponsorship.
  requireSponsorship      Boolean   @default(false)
  preferRelocation        Boolean   @default(true)
  excludeWorkAuthRequired Boolean   @default(true)
  excludeNoSponsorship    Boolean   @default(true)
  aiMatchingEnabled       Boolean   @default(true)
  maxAnalysesPerScan      Int       @default(25)
  /// Matching rubric weights and the high-relevance threshold (see docs/job-scanner.md).
  rubric                  Json?
  scheduleEnabled         Boolean   @default(false)
  /// Local wall-clock time of the daily scan, "HH:mm".
  scheduleTime            String    @default("05:00")
  /// IANA time zone the schedule time is expressed in.
  scheduleTimezone        String    @default("UTC")
  /// Next scheduled run (UTC). The scheduler claims it atomically by advancing it.
  nextRunAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([scheduleEnabled, nextRunAt])
}

/// Per-owner settings of one job source adapter. The adapters themselves are
/// code (src/features/job-scanner/sources); no credentials are stored here.
model JobSourceConfiguration {
  id            String   @id @default(cuid())
  ownerId       String
  sourceId      String
  enabled       Boolean  @default(true)
  configuration Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, sourceId])
}

/// A job posting found by a scan or imported by the owner. Rediscovery updates
/// the listing metadata; the owner's tracking status is never reset.
model JobListing {
  id                  String    @id @default(cuid())
  ownerId             String
  sourceId            String
  /// Identifier assigned by the source (or a hash of the URL for manual imports).
  externalId          String
  /// Normalised company, title and place; matches the same job across sources.
  dedupeKey           String
  /// Original posting URL.
  url                 String
  /// Application URL when the source provides a separate one.
  applyUrl            String?
  title               String
  company             String
  /// Location as stated by the source.
  location            String
  countryCode         String?
  city                String?
  /// onsite | hybrid | remote | unknown
  workArrangement     String    @default("unknown")
  /// Plain text of the posting. Untrusted content; never rendered as HTML.
  description         String
  descriptionHash     String
  postedAt            DateTime?
  discoveredAt        DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  firstScanId         String?
  lastScanId          String?
  seenCount           Int       @default(1)
  /// Other sources that listed the same job: [{ sourceId, url }].
  alsoSeenOn          Json?
  /// automatic (found by a source adapter) | manual (imported by the owner)
  ingestion           String    @default("automatic")
  /// confirmed | possible | unknown | none
  sponsorshipStatus   String    @default("unknown")
  /// 0 confirmed, 1 possible, 2 unknown, 3 none. Used for ordering.
  sponsorshipRank     Int       @default(2)
  /// [{ text, basis, sourceUrl, note }] supporting the classification.
  sponsorshipEvidence Json
  /// offered | not_offered | unknown
  relocationStatus    String    @default("unknown")
  relocationEvidence  Json
  workAuthRequired    Boolean   @default(false)
  workAuthEvidence    Json
  /// new | saved | applied | interviewing | rejected | offer | dismissed
  status              String    @default("new")
  statusChangedAt     DateTime?
  /// Job Match Score (0-100), copied from the match analysis for ordering.
  matchScore          Int?
  /// The job description used by the resume tailoring workflow for this listing.
  jobDescriptionId    String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jobDescription JobDescription?   @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  analysis       JobMatchAnalysis?
  events         JobListingEvent[]

  @@unique([ownerId, sourceId, externalId])
  @@index([ownerId, dedupeKey])
  @@index([ownerId, status])
  @@index([ownerId, sponsorshipRank, matchScore])
  @@index([ownerId, discoveredAt])
}

/// Requirements extracted from a listing by the AI provider and the
/// deterministic match of those requirements against the confirmed profile.
/// The extraction is cached per description; the match per profile revision.
model JobMatchAnalysis {
  id                      String    @id @default(cuid())
  ownerId                 String
  listingId               String    @unique
  /// Hash of the description the requirements were extracted from.
  descriptionHash         String
  /// completed | failed
  status                  String
  failureReason           String?
  attempts                Int       @default(0)
  providerId              String?
  modelId                 String?
  /// Extracted requirements in the job-analysis shape (reused by tailoring).
  analysis                Json?
  /// Sponsorship, relocation and work-authorisation statements quoted by the AI.
  signals                 Json?
  analyzedAt              DateTime?
  careerProfileRevisionId String?
  rubricVersion           Int?
  /// Hash of the rubric weights the score was computed with.
  rubricHash              String?
  score                   Int?
  /// Per-component scores, weights and details.
  breakdown               Json?
  explanation             String?
  matchingSkills          Json?
  missingQualifications   Json?
  matchedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  owner   User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listing JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
}

/// Append-only history of what happened to a listing (status changes,
/// rediscovery with changed content, tailoring).
model JobListingEvent {
  id         String   @id @default(cuid())
  ownerId    String
  listingId  String
  /// discovered | status_changed | content_updated | tailoring_started | imported
  type       String
  fromStatus String?
  toStatus   String?
  detail     String?
  createdAt  DateTime @default(now())

  owner   User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listing JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

/// One execution of the scanner.
model JobScan {
  id              String    @id @default(cuid())
  ownerId         String
  /// manual | scheduled
  trigger         String
  /// running | completed | partial | failed | skipped
  status          String
  /// Holds the owner id while the scan runs; unique, so one scan per owner at a time.
  activeLock      String?   @unique
  /// The schedule slot this run belongs to (scheduled runs only).
  scheduledFor    DateTime?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  heartbeatAt     DateTime  @default(now())
  countries       Json
  keywords        Json
  /// Source ids queried by this run.
  sources         Json
  /// { phase, sourcesDone, sourcesTotal, analyzed, toAnalyze }
  progress        Json?
  discoveredCount Int       @default(0)
  newCount        Int       @default(0)
  duplicateCount  Int       @default(0)
  filteredCount   Int       @default(0)
  analyzedCount   Int       @default(0)
  errorSummary    String?
  diagnostics     Json?

  owner         User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceResults JobScanSourceResult[]

  @@unique([ownerId, scheduledFor])
  @@index([ownerId, startedAt])
}

/// Outcome of one source within a scan. A failed source never fails the scan.
model JobScanSourceResult {
  id             String   @id @default(cuid())
  scanId         String
  sourceId       String
  /// completed | failed | skipped
  status         String
  fetchedCount   Int      @default(0)
  matchedCount   Int      @default(0)
  newCount       Int      @default(0)
  duplicateCount Int      @default(0)
  requestCount   Int      @default(0)
  durationMs     Int      @default(0)
  error          String?
  diagnostics    Json?
  createdAt      DateTime @default(now())

  scan JobScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([sourceId, status, createdAt])
}
